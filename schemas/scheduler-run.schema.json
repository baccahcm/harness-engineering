{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-harness.local/schemas/scheduler-run.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "startedAt",
    "finishedAt",
    "maxParallel",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "maxParallel": {
      "type": "integer",
      "minimum": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "root",
          "status",
          "exitCode",
          "stdout",
          "stderr"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "skipped"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
