{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-harness.local/schemas/task.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "review",
    "acceptance",
    "checkpoints",
    "finalReview"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY_FOR_DEV",
        "IN_PROGRESS",
        "READY_FOR_REVIEW",
        "BLOCKED",
        "COMPLETED"
      ]
    },
    "activeCheckpointId": {
      "type": "string"
    },
    "review": {
      "type": "object",
      "required": [
        "level",
        "reason",
        "selectedBy"
      ],
      "properties": {
        "level": {
          "enum": [
            "NONE",
            "LIGHT",
            "FULL"
          ]
        },
        "selectedBy": {
          "enum": [
            "user",
            "team_leader"
          ]
        },
        "policyOverride": {
          "type": "object",
          "required": [
            "selectedBy"
          ],
          "properties": {
            "approvalsRequired": {
              "type": "integer",
              "minimum": 0
            },
            "maxReviewers": {
              "type": "integer",
              "minimum": 0
            },
            "selectedBy": {
              "enum": [
                "user",
                "team_leader"
              ]
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "array"
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "PENDING",
              "REVISE",
              "APPROVED"
            ]
          },
          "sourceFingerprint": {
            "type": "string"
          },
          "scope": {
            "type": "object",
            "required": [
              "include"
            ],
            "properties": {
              "include": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "approvals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reviewerId",
                "provider",
                "model",
                "sessionId",
                "sourceFingerprint",
                "approvedAt"
              ],
              "properties": {
                "reviewerId": {
                  "type": "string",
                  "minLength": 1
                },
                "provider": {
                  "enum": [
                    "claude",
                    "codex",
                    "antigravity"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "sessionId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceFingerprint": {
                  "type": "string",
                  "minLength": 1
                },
                "approvedAt": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "finalReview": {
      "type": "object",
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PENDING",
            "REVISE",
            "APPROVED"
          ]
        },
        "sourceFingerprint": {
          "type": "string"
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reviewerId",
              "provider",
              "model",
              "sessionId",
              "sourceFingerprint",
              "approvedAt"
            ],
            "properties": {
              "reviewerId": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "enum": [
                  "claude",
                  "codex",
                  "antigravity"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "sourceFingerprint": {
                "type": "string",
                "minLength": 1
              },
              "approvedAt": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "objective": {
      "type": "string"
    },
    "verificationKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "manifestId",
        "sourcePath",
        "sourceSha256",
        "taskSpecId",
        "executionOrder"
      ],
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "minLength": 1
        },
        "taskSpecId": {
          "type": "string",
          "minLength": 1
        },
        "executionOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
