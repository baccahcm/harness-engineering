{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-harness.local/schemas/plan-manifest.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "status",
    "source",
    "planner",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "RUNNING",
        "BLOCKED",
        "COMPLETED"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size",
        "importedAt"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "importedAt": {
          "type": "string"
        }
      }
    },
    "planner": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "analyzedAt",
        "source"
      ],
      "properties": {
        "provider": {
          "enum": [
            "claude",
            "codex",
            "antigravity"
          ]
        },
        "model": {
          "type": "string"
        },
        "analyzedAt": {
          "type": "string"
        },
        "source": {
          "enum": [
            "configured",
            "primary-reviewer"
          ]
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "objective",
          "reviewLevel",
          "reviewReason",
          "acceptance",
          "checkpoints",
          "dependsOn",
          "status",
          "executionOrder"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "reviewLevel": {
            "enum": [
              "NONE",
              "LIGHT",
              "FULL"
            ]
          },
          "reviewReason": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "checkpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "scope"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "scope": {
                  "type": "object",
                  "required": [
                    "include"
                  ],
                  "properties": {
                    "include": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "exclude": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verificationKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "PENDING",
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "executionOrder": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "currentTaskId": {
      "type": "string"
    },
    "approvedAt": {
      "type": "string"
    },
    "approvedBy": {
      "enum": [
        "user",
        "team_leader"
      ]
    },
    "completedAt": {
      "type": "string"
    },
    "lastError": {
      "type": "object",
      "required": [
        "code",
        "message",
        "at"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    }
  }
}
