{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-harness.local/schemas/evidence.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "command", "cwd", "startedAt", "finishedAt", "exitCode", "stdoutPath", "stderrPath", "sourceBefore", "sourceAfter", "sourceStable"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string"},
    "command": {"type": "string"},
    "cwd": {"type": "string"},
    "startedAt": {"type": "string"},
    "finishedAt": {"type": "string"},
    "exitCode": {"type": "integer"},
    "stdoutPath": {"type": "string"},
    "stderrPath": {"type": "string"},
    "sourceBefore": {"$ref": "#/$defs/gitSnapshot"},
    "sourceAfter": {"$ref": "#/$defs/gitSnapshot"},
    "sourceStable": {"type": "boolean"}
  },
  "$defs": {
    "gitSnapshot": {
      "type": "object",
      "required": ["isRepository", "head", "dirty", "changedFiles", "fingerprint"],
      "properties": {
        "isRepository": {"type": "boolean"},
        "head": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"},
        "changedFiles": {"type": "array", "items": {"type": "string"}},
        "fingerprint": {"type": "string"}
      }
    }
  }
}
